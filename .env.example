# TiDB Cloud MySQL database connection
# NOTE: Never commit real credentials. Copy this file to .env and fill in
# your real values (the previous committed ones were leaked — rotate them).
DB_HOST=your_tidbcloud_gateway_host
DB_PORT=4000
DB_NAME=demostore
DB_USER=your_tidbcloud_username
DB_PASSWORD=your_tidbcloud_password

# Environment (production = stricter errors, no demo fallback)
NODE_ENV=development

# --- Vercel / Render deployment notes ---
#
# DB_HOST, DB_USER, DB_PASSWORD, and DB_NAME must be set in your deployment
# platform's environment variables. They do NOT automatically carry over from
# one platform to another (e.g. Render env vars won't appear on Vercel).
#
# On Vercel, add these in Project Settings → Environment Variables.
# On Render, add these in the service's Environment tab.
#
# SSL: In production, DB connections use SSL with certificate verification
# (rejectUnauthorized: true). If your DB provider uses a self-signed cert,
# set DB_SSL_REJECT_UNAUTHORIZED=false to disable verification (not recommended
# for production).
# DB_SSL_REJECT_UNAUTHORIZED=false
#
# File uploads: On Vercel, the filesystem is ephemeral and read-only.
# Local disk uploads (server/api/upload.post.js) will fail with a 501 error.
# To support uploads on Vercel, configure a cloud storage provider (e.g. S3)
# and set UPLOAD_PROVIDER=cloud along with the required cloud storage env vars.
# UPLOAD_PROVIDER=local
